# Gradle and the Android build
.gradle/
.kotlin/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Signing keys and their passwords: CI writes these from secrets, never the tree
*.keystore
*.jks
keystore.properties
test-keystore.properties

# The release tooling's dependencies
node_modules/

# Step output from running a workflow locally (scripts/workflow-steps.mjs writes these
# beside the APK when the digest and publish steps are run by hand)
apk-badging.txt
apk-signature.txt
published-badging.txt
published-signature.txt

# An instance's throwaway accounts and anon key: local, never committed
e2e/fixture.json
e2e/stack.env
e2e/idp/

# Python bytecode from running a repository script by hand (scripts/emoji/gen_emoji.py)
__pycache__/

# Editor and OS noise
.DS_Store
.idea/
*.iml
*.swp
